# No local Ollama in this deployment — chat goes through a remote vLLM server instead
ENABLE_OLLAMA_API=false

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# vLLM (OpenAI-compatible) backend on another machine — point at it by IP, include /v1
# OPENAI_API_BASE_URLS='http://<vllm-server-ip>:8000/v1'
# OPENAI_API_KEYS='none'
# Cross-machine "list models" calls can be slower than localhost; default is 10s
# AIOHTTP_CLIENT_TIMEOUT_OPENAI_MODEL_LIST='30'

# Postgres (replaces the default SQLite webui.db)
# DATABASE_URL='postgresql://openwebui:changeme@postgres:5432/openwebui'
# Optional: also move the RAG/memory vector store into the same Postgres instance
# instead of the local Chroma files under DATA_DIR/vector_db
# VECTOR_DB='pgvector'

# User memory (Settings > Personalization > Memory)
# ENABLE_MEMORIES: master switch for the memory feature (storage + retrieval)
# ENABLE_MEMORY_SYSTEM_CONTEXT: inject stored memories into the system prompt on every chat
# ENABLE_MEMORY_BACKGROUND_REVIEW: after every MEMORIES_REVIEW_INTERVAL_TURNS user turns, ask the
#   active model (your vLLM model) to decide what to add/update/remove in long-term memory.
#   OFF by default — turn this on for memories to build up automatically from conversations,
#   otherwise users must add memories manually.
# ENABLE_MEMORIES=true
# ENABLE_MEMORY_SYSTEM_CONTEXT=true
# ENABLE_MEMORY_BACKGROUND_REVIEW=true
# MEMORIES_REVIEW_INTERVAL_TURNS=10
# MEMORIES_USER_CHAR_LIMIT=2000
# MEMORIES_CONTEXT_CHAR_LIMIT=2000

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# Set to false to keep memory tools enabled without adding memory context to the system context.
ENABLE_MEMORY_SYSTEM_CONTEXT=true

# Set to false to disable workspace Tools and Functions.
ENABLE_PLUGINS=true

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'

# BdREN Accounts SSO (OAuth2)
# Register your app with BdREN and set the redirect URI to:
#   https://<your-domain>/oauth/bdren/login/callback
# ENABLE_OAUTH=true
# ENABLE_OAUTH_SIGNUP=true
# BDREN_CLIENT_ID=''
# BDREN_CLIENT_SECRET=''
# BDREN_OAUTH_BASE_URL='https://accounts.bdren.net.bd'
# BDREN_REDIRECT_URI='https://<your-domain>/oauth/bdren/login/callback'
# BDREN_OAUTH_SCOPE='profile'
# BdREN's profile response has no "name" field, only "username" + first/last name
# OAUTH_USERNAME_CLAIM='username'
# BdREN's profile response uses "avatar", not "picture"
# OAUTH_PICTURE_CLAIM='avatar'
# OAUTH_UPDATE_PICTURE_ON_LOGIN=true
# Restrict sign-in to BdREN member institution email domains (comma-separated), default '*' allows any
# OAUTH_ALLOWED_DOMAINS='*'
# Optional: also end the BdREN SSO session on Open WebUI logout (RP-initiated logout).
# Bake client_id + post_logout_redirect_uri into the URL since Open WebUI passes this through as-is.
# OPENID_END_SESSION_ENDPOINT='https://accounts.bdren.net.bd/oauth/logout/?client_id=YOUR_CLIENT_ID&post_logout_redirect_uri=https://<your-domain>/'


